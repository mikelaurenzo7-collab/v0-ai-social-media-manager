# ============================================================
# PostPilot — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# ---------------------------------------------------------------
# Anthropic (Required)
# Powers AI content generation, the assistant chat, and content
# improvement features. Get your key at https://console.anthropic.com
# ---------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------
# Vercel (Optional — auto-set in Vercel deployments)
# ---------------------------------------------------------------
# VERCEL_URL=your-app.vercel.app
# NODE_ENV=production
