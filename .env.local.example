# ============================================================
# v0-ai-social-media-manager — Environment Variables
# ============================================================

# AI Providers
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GROK_API_KEY=...

# Database (Prisma + Supabase or Neon)
DATABASE_URL="postgresql://..."

# NextAuth.js
NEXTAUTH_SECRET=super-secret-key-change-in-production
NEXTAUTH_URL=http://localhost:3000

# Social Platform OAuth Credentials (get from developer portals)
# Twitter / X
TWITTER_CLIENT_ID=...
TWITTER_CLIENT_SECRET=...

# LinkedIn
LINKEDIN_CLIENT_ID=...
LINKEDIN_CLIENT_SECRET=...

# Instagram / Meta
META_CLIENT_ID=...
META_CLIENT_SECRET=...

# TikTok
TIKTOK_CLIENT_ID=...
TIKTOK_CLIENT_SECRET=...

# General
NEXT_PUBLIC_APP_URL=http://localhost:3000
