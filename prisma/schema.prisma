generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts          Account[]
  sessions          Session[]
  socialConnections SocialConnection[]
  agentSettings     AgentSetting[]
  drafts            Draft[]
  threads           Thread[]
  scheduledPosts    ScheduledPost[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AgentSetting {
  id         String   @id
  userId     String
  agentId    String
  creativity Int      @default(50)
  tone       Int      @default(75)
  memory     Json     @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, agentId])
  @@index([userId])
}

model SocialConnection {
  id                    String   @id @default(cuid())
  userId                String
  platform              String   // twitter, instagram, linkedin, tiktok, facebook, gmail, outlook
  encryptedAccessToken  String   @db.Text
  encryptedRefreshToken String?  @db.Text
  expiresAt             DateTime?
  accountId             String
  username              String?
  displayName           String?
  email                 String?
  avatarUrl             String?
  scopes                String[]
  metadata              Json?    // platform-specific data (page IDs, IG business account, etc.)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  publishedPosts        PublishedPost[]
  @@unique([userId, platform])
  @@index([userId])
}

model OAuthState {
  id           String   @id @default(cuid())
  state        String   @unique
  userId       String
  platform     String
  codeVerifier String?  @db.Text
  redirectUri  String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  @@index([state])
  @@index([expiresAt])
}

model PublishedPost {
  id              String   @id @default(cuid())
  userId          String
  connectionId    String
  platform        String
  externalId      String?  // ID on the social platform
  content         String   @db.Text
  status          String   @default("published") // published, failed, scheduled
  error           String?  @db.Text
  metadata        Json?
  publishedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  connection      SocialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([connectionId])
}

model Draft {
  id          String   @id
  userId      String
  content     String   @db.Text
  platforms   String[]
  hashtags    String[]
  tone        String   @default("casual")
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Thread {
  id        String   @id
  userId    String
  title     String
  topic     String   @db.Text
  tone      String   @default("casual")
  tweets    Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ScheduledPost {
  id           String   @id
  userId       String
  content      String   @db.Text
  platforms    String[]
  scheduledFor DateTime
  status       String   @default("scheduled") // scheduled, published, failed, cancelled
  attempts     Int      @default(0)
  error        String?  @db.Text
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status, scheduledFor])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}
