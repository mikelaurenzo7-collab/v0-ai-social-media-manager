generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  socialConnections SocialConnection[]
  profile       UserProfile?
}

model UserProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  // Mode + identity
  mode              String?  // 'business' | 'creator' | 'personal'
  brandName         String?
  brandTagline      String?  @db.Text
  brandWebsite      String?
  niche             String?
  // Goals + audience
  primaryGoal       String?  // 'growth' | 'leads' | 'sales' | 'community' | 'authority' | 'monetization' | 'personal-brand' | 'recruiting' | 'support'
  goals             String[] @default([])
  audience          String?  @db.Text
  audienceLocation  String?
  contentPillars    String[] @default([])
  brandKeywords     String[] @default([])
  // Voice
  voiceDescription  String?  @db.Text
  doWords           String[] @default([])
  dontWords         String[] @default([])
  tone              String?
  emojiUsage        String?  // 'none' | 'sparing' | 'liberal'
  // Cadence
  postingFrequency  String?
  timezone          String?
  hashtagStyle      String?  // 'none' | 'minimal' | 'standard' | 'aggressive'
  preferredFormats  String[] @default([])
  // Per-agent platform defaults (Slack channel, Pinterest board, email signature, etc.)
  perAgent          Json?
  // Onboarding state
  onboardingComplete Boolean @default(false)
  onboardingStep    Int      @default(0)
  // Voice-learning snapshot
  voiceLearnedAt    DateTime?
  voiceLearnedFrom  String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SocialConnection {
  id                    String   @id @default(cuid())
  userId                String
  platform              String   // twitter, instagram, linkedin, tiktok, facebook, gmail, outlook
  encryptedAccessToken  String   @db.Text
  encryptedRefreshToken String?  @db.Text
  expiresAt             DateTime?
  accountId             String
  username              String?
  displayName           String?
  email                 String?
  avatarUrl             String?
  scopes                String[]
  metadata              Json?    // platform-specific data (page IDs, IG business account, etc.)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  publishedPosts        PublishedPost[]
  @@unique([userId, platform])
  @@index([userId])
}

model OAuthState {
  id           String   @id @default(cuid())
  state        String   @unique
  userId       String
  platform     String
  codeVerifier String?  @db.Text
  redirectUri  String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  @@index([state])
  @@index([expiresAt])
}

model PublishedPost {
  id              String   @id @default(cuid())
  userId          String
  connectionId    String
  platform        String
  externalId      String?  // ID on the social platform
  content         String   @db.Text
  status          String   @default("published") // published, failed, scheduled
  error           String?  @db.Text
  metadata        Json?
  publishedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  connection      SocialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([connectionId])
}

// Existing live table — column shape preserved exactly.
model ScheduledPost {
  id           String    @id @default(cuid())
  userId       String
  content      String    @db.Text
  platforms    String[]  @default([]) // 'twitter','instagram','linkedin','facebook','tiktok','pinterest','snapchat'
  scheduledFor DateTime
  status       String    @default("scheduled") // scheduled | published | cancelled | failed
  attempts     Int       @default(0)
  lastError    String?   @db.Text
  publishedAt  DateTime?
  metadata     Json?     // { mediaUrls?, timezone?, agentId?, draftId?, externalId? }
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  @@index([userId])
  @@index([scheduledFor])
  @@index([userId, status])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}
