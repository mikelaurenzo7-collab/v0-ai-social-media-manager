# ── Database ────────────────────────────────────────────────────────────────
# Postgres connection string used by Prisma. e.g. postgres://user:pass@host:5432/db
DATABASE_URL=

# ── Application ─────────────────────────────────────────────────────────────
# Public base URL of the deployment. Used to build OAuth redirect URIs.
# Production: https://yourdomain.com
# Local:      http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 64-char (32-byte) hex string used for AES-256-GCM token encryption at rest.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# ── AI ──────────────────────────────────────────────────────────────────────
# Anthropic key, used by the chat agents.
ANTHROPIC_API_KEY=

# ── Gmail (Google Cloud Console → OAuth client) ─────────────────────────────
# Authorized redirect URI: ${NEXT_PUBLIC_APP_URL}/api/oauth/gmail/callback
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# ── Outlook (Azure AD → App registration) ───────────────────────────────────
# Authorized redirect URI: ${NEXT_PUBLIC_APP_URL}/api/oauth/outlook/callback
# Tenant: "common" supports both work and personal Microsoft accounts.
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT=common

# ── X / Twitter (developer.x.com → OAuth 2.0) ───────────────────────────────
# Authorized redirect URI: ${NEXT_PUBLIC_APP_URL}/api/oauth/twitter/callback
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# ── LinkedIn (linkedin.com/developers → Sign In with LinkedIn using OpenID Connect) ──
# Authorized redirect URI: ${NEXT_PUBLIC_APP_URL}/api/oauth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── Meta (Facebook + Instagram) ─────────────────────────────────────────────
# developers.facebook.com → App → Facebook Login product
# Authorized redirect URI: ${NEXT_PUBLIC_APP_URL}/api/oauth/facebook/callback
# AND                       ${NEXT_PUBLIC_APP_URL}/api/oauth/instagram/callback
META_CLIENT_ID=
META_CLIENT_SECRET=

# ── TikTok (developers.tiktok.com → Login Kit + Content Posting API) ─────────
# Authorized redirect URI: ${NEXT_PUBLIC_APP_URL}/api/oauth/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
